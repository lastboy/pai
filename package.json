{
  "name": "@lastboy/pai",
  "version": "0.3.1",
  "description": "PAI — Personal AI Supervisor: a local-first CLI that observes how you work with AI coding agents and turns it into knowledge you own",
  "keywords": [
    "cli",
    "claude-code",
    "ai",
    "coding-agent",
    "developer-tools",
    "local-first",
    "productivity"
  ],
  "homepage": "https://github.com/lastboy/pai#readme",
  "bugs": {
    "url": "https://github.com/lastboy/pai/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lastboy/pai.git"
  },
  "license": "MIT",
  "author": "Arik Lewin",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "pai": "./dist/cli/index.js"
  },
  "files": [
    "dist",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "tsx src/cli/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "commander": "^15.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
